{
	"name": "parkhub-challenge-backend",
	"version": "1.0.0",
	"main": "./dist/main.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"start": "node dist/main.js",
		"build": "pkgroll",
		"build:docker": "docker build -t nfl-game-dashboard .",
		"postbuild": "cp package.json dist/ && cp pnpm-lock.yaml dist/",
		"clean": "rimraf dist",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write",
		"test": "vitest run",
		"check": "pnpm lint && pnpm format && pnpm test"
	},
	"dependencies": {
		"cron-parser": "^4.9.0",
		"dotenv": "^16.4.7",
		"envalid": "^8.0.0",
		"express": "^4.21.2",
		"http-status-codes": "^2.3.0",
		"ioredis": "^5.5.0",
		"kysely": "^0.27.5",
		"lodash": "^4.17.21",
		"node-cron": "^3.0.3",
		"pg": "^8.13.3",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.3",
		"@types/express": "^5.0.0",
		"@types/lodash": "^4.17.15",
		"@types/node": "^22.13.5",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.11.11",
		"pkgroll": "^2.11.0",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^2.1.9"
	},
	"packageManager": "pnpm@9.15.2"
}
